                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Short Description"
          },
          "developers": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Developers"
          },
          "publishers": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Publishers"
          },
          "genres": {
            "items": {
              "$ref": "#/components/schemas/SteamGenre"
            },
            "type": "array",
            "title": "Genres"
          },
          "categories": {
            "items": {
              "$ref": "#/components/schemas/SteamCategory"
            },
            "type": "array",
            "title": "Categories"
          },
          "platforms": {
            "$ref": "#/components/schemas/SteamPlatforms"
          },
          "release_date": {
            "$ref": "#/components/schemas/SteamReleaseDate"
          },
          "is_free": {
            "type": "boolean",
            "title": "Is Free"
          },
          "price": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SteamPrice"
              },
              {
                "type": "null"
              }
            ]
          },
          "header_image": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Header Image"
          },
          "website": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Website"
          },
          "metacritic_score": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Metacritic Score"
          },
          "recommendation_count": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Recommendation Count"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "app_id",
          "store_url",
          "name",
          "platforms",
          "release_date",
          "is_free"
        ],
        "title": "SteamGameMetadata"
      },
      "SteamGenre": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          }
        },
        "type": "object",
