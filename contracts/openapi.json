{
  "openapi": "3.1.0",
  "info": {
    "title": "Indie Launch Intelligence API",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/steam/games/inspect": {
      "post": {
        "tags": [
          "steam"
        ],
        "summary": "Inspect Game",
        "operationId": "inspect_game_api_v1_steam_games_inspect_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InspectSteamGameRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InspectSteamGameResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "InspectSteamGameRequest": {
        "properties": {
          "steam_url": {
            "type": "string",
            "maxLength": 500,
            "minLength": 20,
            "title": "Steam Url"
          },
          "country_code": {
            "type": "string",
            "pattern": "^[A-Za-z]{2}$",
            "title": "Country Code",
            "default": "US"
          },
          "language": {
            "type": "string",
            "maxLength": 32,
            "minLength": 2,
            "title": "Language",
            "default": "english"
          },
          "review_language": {
            "type": "string",
            "maxLength": 32,
            "minLength": 2,
            "title": "Review Language",
            "default": "all"
          },
          "review_count": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Review Count",
            "default": 100
          }
        },
        "type": "object",
        "required": [
          "steam_url"
        ],
        "title": "InspectSteamGameRequest"
      },
      "InspectSteamGameResponse": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/SteamGameInspection"
          },
          "meta": {
            "$ref": "#/components/schemas/InspectionMeta"
          }
        },
        "type": "object",
        "required": [
          "data",
          "meta"
        ],
        "title": "InspectSteamGameResponse"
      },
      "InspectionMeta": {
        "properties": {
          "source": {
            "type": "string",
            "const": "steam",
            "title": "Source",
            "default": "steam"
          },
          "cache_hit": {
            "type": "boolean",
            "title": "Cache Hit"
          },
          "cache_ttl_seconds": {
            "type": "integer",
            "title": "Cache Ttl Seconds"
          }
        },
        "type": "object",
        "required": [
          "cache_hit",
          "cache_ttl_seconds"
        ],
        "title": "InspectionMeta"
      },
      "SteamCategory": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "title": "SteamCategory"
      },
      "SteamGameInspection": {
        "properties": {
          "metadata": {
            "$ref": "#/components/schemas/SteamGameMetadata"
          },
          "reviews": {
            "items": {
              "$ref": "#/components/schemas/SteamReview"
            },
            "type": "array",
            "title": "Reviews"
          },
          "review_summary": {
            "$ref": "#/components/schemas/SteamReviewSummary"
          },
          "current_players": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Current Players"
          },
          "fetched_at": {
            "type": "string",
            "format": "date-time",
            "title": "Fetched At"
          }
        },
        "type": "object",
        "required": [
          "metadata",
          "reviews",
          "review_summary",
          "fetched_at"
        ],
        "title": "SteamGameInspection"
      },
      "SteamGameMetadata": {
        "properties": {
          "app_id": {
            "type": "integer",
            "title": "App Id"
          },
          "store_url": {
            "type": "string",
            "title": "Store Url"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "app_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
