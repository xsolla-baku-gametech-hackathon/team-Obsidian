          },
          "votes_funny": {
            "type": "integer",
            "title": "Votes Funny"
          },
          "weighted_vote_score": {
            "type": "number",
            "title": "Weighted Vote Score"
          },
          "comment_count": {
            "type": "integer",
            "title": "Comment Count"
          },
          "steam_purchase": {
            "type": "boolean",
